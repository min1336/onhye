# Server-only credentials. Never use a VITE_ prefix.
WELFARE_API_KEY=
GOV24_API_KEY=
GOOGLE_CLOUD_PROJECT=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after the linked Cloud Billing account confirms Postpay.
GOOGLE_CLOUD_POSTPAY_CONFIRMED=false
# Google authentication uses Application Default Credentials (ADC).
# On deployment, use the runtime service account instead of a downloaded key.
PORT=5173

# 공공데이터포털 K-Startup 활용 승인 후 사용 (미지정 시 WELFARE_API_KEY 사용)
KSTARTUP_API_KEY=

# AI abuse controls. Default limits: session 3/min, 10/UTC-day; total 100/UTC-day.
# Keep one durable shared SQLite file across restarts. Never place it in public/dist.
AI_GUARD_FILE=.private/ai-guard.sqlite
AI_ENABLED=true
# Required for public/production AI. Without all three, only manual/demo works.
PUBLIC_ORIGIN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel server-only identity federation (no Google private key).
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Use a server-only random secret of at least 64 characters; never VITE_-prefix it.
AI_SESSION_SECRET=
# Operator control: set firestore for the public shared guard, omit for local SQLite.
AI_GUARD_PROVIDER=
# Public BotID client configuration, set only for Vercel builds.
VITE_BOT_PROVIDER=
